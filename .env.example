# DealSure environment variables — placeholders only.
# Copy to .env / .env.local and fill in real values. NEVER commit real secrets.

# ── Frontend (VITE_* is bundled and sent to the browser — public-safe ONLY) ──
# Convex deployment URL (current backend; Supabase replaces it during migration)
VITE_CONVEX_URL=https://your-convex-deployment.convex.site
# VLY monitoring/app ids (public-safe integration identifiers)
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# ── Convex server env (server-side only; set in Convex dashboard) ──
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=https://your-convex-deployment.convex.site
# Freebuff email OTP API key — SERVER SECRET, never expose to the browser
VLY_EMAIL_API_KEY=
VLY_APP_NAME=DealSure
# NOTE: VLY_CONVEX_AUTH_ISSUER (Freebuff federated JWT) was retired in Phase 2
# (Decision B). Do not re-add it without an approved production dependency.
# GitHub dev tooling token (Convex actions only)
GITHUB_TOKEN=

# ── VLY integrations (server-side Convex actions) ──
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com/

# ── Turso / libSQL (startup database; server-side ONLY) ──
# URL selects the mode: libsql://… (cloud), file:./dev.db (local file),
# :memory: (ephemeral, tests/dev default when unset outside production).
# NEVER expose these via VITE_*. Production without a cloud URL fails closed.
TURSO_DATABASE_URL=
# Cloud auth token — SERVER SECRET. Required with libsql(s):// URLs.
TURSO_AUTH_TOKEN=

# ── DealSure API (Phase 4 read foundation; Convex remains authoritative) ──
# Port for `npm run dev:api`. CORS origins allowlist, comma-separated
# scheme://host entries. Empty = same-origin only (no CORS headers).
API_PORT=3001
CORS_ALLOWED_ORIGINS=

# ── Supabase (target during migration; see docs/migration/migration-plan.md) ──
# Public-safe: URL and publishable key are meant to be exposed to the client.
# Prefer the modern publishable-key name for new frontend code. VITE_SUPABASE_ANON_KEY
# is kept as a temporary alias while legacy call sites are migrated; do not add new uses.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
# SERVER SECRETS — Edge Functions / server only. NEVER in VITE_* or frontend code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Payment provider keys (licensed partner) — server secrets only
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Webhook signing secrets — server secrets only
PAYMENT_WEBHOOK_SECRET=
# OTP hashing secret (delivery codes) — server secret only
DELIVERY_OTP_HASH_SECRET=
# Delivery OTP lifetime in seconds (default 600 = 10 min; short in-person
# handover window — do NOT raise toward hours without a security review)
DELIVERY_OTP_TTL_SECONDS=600
# Return the generated delivery OTP once from dispatch for sandbox/demo UI.
# Must be "true" ONLY in development/demo; NEVER in production.
DELIVERY_OTP_DEV_REVEAL=false
# Step-up MFA gate: set "true" in production to DENY privileged actions
# (role changes, refund approvals) until MFA is enforced. Dev default off
# (actions run with an explicit STEP_UP_DEFERRED audit record).
STEP_UP_ENFORCED=false
# Extra origins allowed to drive the embedded-app navigation channel,
# comma-separated (same origin is always allowed). Empty = same-origin only.
VITE_TRUSTED_EMBED_ORIGINS=